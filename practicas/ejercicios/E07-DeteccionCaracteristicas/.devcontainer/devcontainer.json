{
  "name": "DWEC - E07-DeteccionCaracteristicas",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "runArgs": ["--security-opt", "label=disable"],
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "vitest.explorer",
        "usernamehw.errorlens",
        "bierner.markdown-mermaid"
      ]
    }
  },
  "forwardPorts": [3507],
  "portsAttributes": {
    "3507": { "label": "Página", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "node --version && npm --version && echo '✅ Contenedor listo'",
  "postAttachCommand": "npx --yes serve@14.2.6 --no-clipboard --listen 3507 .",
  "remoteUser": "node"
}
